# Copy to .env and fill in. NEVER commit .env.

# --- Postgres ---
POSTGRES_USER=ai_sales_coach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_sales_coach

# --- App ---
NODE_ENV=development
PORT=8080
PUBLIC_APP_URL=http://localhost:5183
# Loopback host ports (kept distinct from other projects on this box).
BACKEND_HOST_PORT=8090
FRONTEND_HOST_PORT=5183

# --- Auth (M4) --- generate a long random value: openssl rand -hex 32
BETTER_AUTH_SECRET=

# --- Encryption for per-tenant provider tokens (M3/M4) --- 32-byte hex: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# --- OpenRouter inference (M2) --- https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Realtime coaching (RT-0) ---
# Secret to sign/verify the short-lived realtime session token. Generate: openssl rand -hex 32
# If blank, the service falls back to BETTER_AUTH_SECRET.
REALTIME_TOKEN_SECRET=
# Loopback host port for the realtime WS in dev.
REALTIME_HOST_PORT=8091
# Public WS URL handed to clients. Dev: ws://localhost:8091 · Prod: wss://<domain>/realtime
PUBLIC_REALTIME_URL=ws://localhost:8091

# --- Live cue engine (RT-3) --- Anthropic direct, Haiku 4.5. https://console.anthropic.com/
# If blank, the realtime service still runs (handshake/consent/session lifecycle) but the live
# cue engine stays OFF — nothing else changes. Deliberately separate from OPENROUTER_* (the
# async grader): the live path calls Anthropic directly for latency + prompt caching.
ANTHROPIC_API_KEY=
# Optional model override for the cue engine.
REALTIME_CUE_MODEL=claude-haiku-4-5-20251001

# --- Observability: PostHog (error tracking + RUM) ---
# Project API key (phc_…): PostHog → Settings → Project → "Project API Key". Client-safe; used by
# BOTH the server SDKs (posthog-node in backend + realtime) and the browser/desktop SDKs (posthog-js).
# Blank => all capture is a no-op and the apps run unchanged. (compose maps this to POSTHOG_KEY.)
POSTHOG_PROJECT_TOKEN=
# Numeric project id (PostHog → Settings → Project). Used by the PostHog MCP / HTTP API, not the SDK.
POSTHOG_PROJECT_ID=
# Region label for humans (US Cloud / EU Cloud / self-hosted). The SDKs actually use POSTHOG_HOST below.
POSTHOG_REGION=US Cloud
# Region host the SDKs talk to — MUST match your region, or events are silently dropped:
# US=https://us.i.posthog.com · EU=https://eu.i.posthog.com · or your self-hosted URL.
POSTHOG_HOST=https://us.i.posthog.com
# Personal API key (phx_…): SECRET, server-only. PostHog → Settings → "Personal API keys".
# Used ONLY by the PostHog MCP so the agent can query errors/insights. Never sent to the browser.
POSTHOG_PERSONAL_API_KEY=
# Browser + desktop builds read the token+host at BUILD time (Vite). They default to
# POSTHOG_PROJECT_TOKEN / POSTHOG_HOST via docker-compose build args, so normally leave blank.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ============================================================================
# Production deploy (M7) — only used by docker-compose.prod.yml. Leave blank in dev.
# ============================================================================
# Public domain; point an A record at the box's public IP. Caddy gets a TLS cert for it.
PUBLIC_DOMAIN=
# Email for Let's Encrypt expiry / recovery notices.
ACME_EMAIL=
# In PROD, set both of these to your https domain (app + API are the same origin
# behind Caddy). In dev leave them as the localhost defaults above / unset.
#   PUBLIC_APP_URL=https://your-domain.com
#   PUBLIC_API_URL=https://your-domain.com
# Also set NODE_ENV=production for a prod box.
