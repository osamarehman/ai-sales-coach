# ============================================================================
# ai-sales-coach — APPEND this block to /root/fanstart/infra/Caddyfile
# ============================================================================
# Routes a subdomain to the ai-sales-coach frontend + API through the existing
# fanstart edge. Caddy auto-provisions a Let's Encrypt cert (the global `email`
# at the top of that Caddyfile is reused — no `tls` directive needed).
#
# Prerequisites:
#   1. DNS: sales-coach.shipdeck.dev  A record -> 169.58.20.145 (this box), DNS-only.
#   2. Our containers up on the shared network, and this edge connected to it:
#        docker network connect salescoach_edge fanstart-edge-1
#   3. Reload the edge with zero downtime after editing:
#        docker exec fanstart-edge-1 caddy reload --config /etc/caddy/Caddyfile
#
# Change the hostname below if you pick a different subdomain (keep PUBLIC_APP_URL /
# PUBLIC_API_URL in .env matching it).

sales-coach.shipdeck.dev {
	# API + BetterAuth -> our backend container (unique name, no alias collision).
	handle /api/* {
		reverse_proxy ai-sales-coach-backend-1:8080
	}
	# Everything else -> our SolidJS frontend.
	handle {
		reverse_proxy ai-sales-coach-frontend-1:5173
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
