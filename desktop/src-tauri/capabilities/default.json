{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Overlay window: core commands + dragging the frameless window.",
  "windows": ["overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-always-on-top",
    "core:window:allow-close",
    "core:event:default"
  ]
}
