{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Sales Coach",
  "version": "0.1.2",
  "identifier": "dev.shipdeck.aisalescoach",
  "build": {
    "beforeDevCommand": "bun run --cwd ui dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "AI Sales Coach",
        "width": 380,
        "height": 260,
        "minWidth": 320,
        "minHeight": 180,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws: wss:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/osamarehman/ai-sales-coach/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI1NTYxQkYwMjRFQUNERkUKUldUK3plb2s4QnRXdFhZNkNrdHBYVldHZW1RcFIxdE9RREt2c2JINnpId1NmM1VGQURTdS94U2gK"
    }
  }
}
