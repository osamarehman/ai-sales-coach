{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Sales Coach",
  "version": "0.1.0",
  "identifier": "dev.shipdeck.aisalescoach",
  "build": {
    "beforeDevCommand": "bun --cwd ../ui run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun --cwd ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "AI Sales Coach",
        "width": 380,
        "height": 260,
        "minWidth": 320,
        "minHeight": 180,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ws: wss:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
